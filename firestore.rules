rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para verificar se o usuário é membro de uma família
    function isFamilyMember(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.memberIds.hasAny([request.auth.uid]);
    }

    // Regras para a collection 'users'
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Regras para a collection 'families'
    match /families/{familyId} {
      // Usuário autenticado pode fazer query na collection e ler documentos onde é membro
      allow list: if request.auth != null;
      allow read: if request.auth != null && isFamilyMember(familyId);
      
      // Usuário autenticado pode criar nova família
      allow create: if request.auth != null && 
                       request.resource.data.memberIds is list &&
                       request.resource.data.memberIds.hasAny([request.auth.uid]) &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.createdAt == request.time;
      
      // Apenas o criador pode atualizar família
      allow update: if request.auth != null && 
                       resource.data.createdBy == request.auth.uid;
      
      allow delete: if false; // Não permitir delete de famílias

      // Regras para subcollections de entries
      match /entries/{entryId} {
        allow read: if request.auth != null && isFamilyMember(familyId);
        
        allow create: if request.auth != null && 
                         isFamilyMember(familyId) &&
                         request.resource.data.ownerId == request.auth.uid &&
                         request.resource.data.familyId == familyId &&
                         request.resource.data.createdAt == request.time;
        
        allow update: if request.auth != null && 
                         isFamilyMember(familyId) &&
                         resource.data.ownerId == request.auth.uid;
        
        allow delete: if request.auth != null && 
                         isFamilyMember(familyId) &&
                         resource.data.ownerId == request.auth.uid;
      }

      // Regras para subcollections de goals
      match /goals/{goalId} {
        allow read: if request.auth != null && isFamilyMember(familyId);
        
        allow create: if request.auth != null && 
                         isFamilyMember(familyId) &&
                         request.resource.data.familyId == familyId &&
                         request.resource.data.createdAt == request.time;
        
        allow update: if request.auth != null && isFamilyMember(familyId);
        
        allow delete: if request.auth != null && isFamilyMember(familyId);
      }

      // Regras para subcollections de categories
      match /categories/{categoryId} {
        allow read: if request.auth != null && isFamilyMember(familyId);
        
        allow create: if request.auth != null && 
                         isFamilyMember(familyId) &&
                         request.resource.data.familyId == familyId &&
                         request.resource.data.createdAt == request.time;
        
        allow update: if request.auth != null && isFamilyMember(familyId);
        
        allow delete: if request.auth != null && isFamilyMember(familyId);
      }

      // Regras para subcollections de invites
      match /invites/{inviteId} {
        allow read: if request.auth != null && 
                       (isFamilyMember(familyId) || 
                        request.auth.email == resource.data.toEmail);
        
        allow create: if request.auth != null && 
                         isFamilyMember(familyId) &&
                         request.resource.data.fromUid == request.auth.uid &&
                         request.resource.data.familyId == familyId &&
                         request.resource.data.status == 'pending' &&
                         request.resource.data.createdAt == request.time;
        
        allow update: if request.auth != null && 
                         (resource.data.toEmail == request.auth.email ||
                          isFamilyMember(familyId));
        
        allow delete: if request.auth != null && isFamilyMember(familyId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
